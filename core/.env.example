# Sao chép thành .env rồi chỉnh (hoặc export trực tiếp ra môi trường).

# MOCK=1 -> trả fixtures/*.json (không cần API key, không cần model).
# MOCK=0 -> chạy pipeline thật.
MOCK=1

# Bắt buộc khi MOCK=0 và KHÔNG bật OFFLINE_LLM.
ANTHROPIC_API_KEY=

# Model LLM (theo spec). LƯU Ý: đây là model cho Claude.
# Nếu đổi sang OpenAI (LLM_PROVIDER=openai) PHẢI set OPENAI_MODEL riêng (vd gpt-4o-mini),
# nếu không core sẽ lấy nhầm 'claude-...' cho OpenAI và bị chặn (core báo lỗi rõ).
LLM_MODEL=claude-sonnet-4-6

# --- Tùy chọn nâng cao ---
# OFFLINE_LLM=1  -> dùng bộ trích skill offline (test double), không gọi API.
#                    Vẫn dùng embedding thật để normalize. Dành cho demo/test.
# EMB_THRESHOLD=0.62   ngưỡng cosine cho lớp embedding.
# CACHE_DISABLED=1     tắt cache LLM.
